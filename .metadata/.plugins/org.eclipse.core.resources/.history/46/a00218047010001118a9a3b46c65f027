package zeldaminiclone;

import java.awt.Color;
import java.awt.Graphics;
import java.awt.Rectangle;
import java.util.ArrayList;
import java.util.List;

public class Player extends Rectangle{
	
	public int spd = 3;
	public boolean right, up, down, left, shoot;
	public int dir = 1;
	
	//Sprites
	
	public boolean player_side_sprite = false;
	public boolean player_front_sprite = true;
	public boolean player_back_sprite = false;
	
	public boolean facingRight = true;
	
	public int curAnimation = 0;
	public int curFrames = 0;
	public int targetFrames = 15;
	
	//Projeteis
	
	public static List<Bullet> bullets = new ArrayList<>();
	
	
	public Player(int x, int y) {
		super(x,y,32,32);
	}
		
	public void tick() {
		boolean moved = false;
		if (right && World.isFree(x+spd, y)) {
			x += spd;
			moved = true;
			player_side_sprite = true;
			player_front_sprite = false;
			facingRight = false;
		}
		else if(left && World.isFree(x-spd, y)) {
			x -= spd;
			moved = true;
			player_side_sprite = true;
			player_front_sprite = false;
			facingRight = true;
		}
		
		if (up && World.isFree(x, y-spd)) {
			y -= spd;
			moved = true;
			player_side_sprite = false;
			player_front_sprite = false;
			player_back_sprite = true;
		}
		else if(down && World.isFree(x, y+spd)) {
			y += spd;
			moved = true;
			player_side_sprite = false;
			player_front_sprite = true;
			player_back_sprite = false;
		}
		
		if(moved) {
			curFrames++;
			if(curFrames == targetFrames) {
				curFrames = 0;
				curAnimation++;
				if(curAnimation == Spritesheet.player_front.length) {
					curAnimation = 0;
				}
				if(curAnimation == Spritesheet.player_side.length) {
					curAnimation = 0;
				}
				if(curAnimation == Spritesheet.player_back.length) {
					curAnimation = 0;
				}
			}			
		}
		
		if(shoot) {
			shoot = false;
			bullets.add(new Bullet(x,y,1));
		}
		
		for(int i = 0; i < bullets.size(); i ++) {
			bullets.get(i).tick();
		}
		
		
	}
	
	public void render(Graphics g) {
		/*g.setColor(Color.blue);
		g.fillRect(x, y, width, height);*/
	    if (player_side_sprite) {
	        if (facingRight) {
	            g.drawImage(Spritesheet.player_side[curAnimation],
	                        x + width, y, -width, height, null);
	        } else {
	            g.drawImage(Spritesheet.player_side[curAnimation],
	                        x, y, width, height, null);
	        }
	    } 
	    else if (player_front_sprite) {
	        g.drawImage(Spritesheet.player_front[curAnimation],
	                    x, y, width, height, null);
	    }
	    else if (player_back_sprite) {
	    	g.drawImage(Spritesheet.player_back[curAnimation], x, y, width, height, null);
	    }
	    
	    for(int i = 0; i < bullets.size(); i ++) {
			bullets.get(i).render(g);
		}
	}
}
